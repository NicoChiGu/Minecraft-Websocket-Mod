{
  "schemaVersion": 1,
  "id": "minecraft_websocket_tunnel",
  "version": "${version}",
  "name": "Minecraft WebSocket Tunnel",
  "description": "Transparent Minecraft TCP over WebSocket tunnel for client and server.",
  "authors": ["Terata"],
  "license": "MIT",
  "icon": "assets/minecraft_websocket_tunnel/icon.png",
  "environment": "*",
  "entrypoints": {
    "server": ["dev.terata.mctunnel.fabric.MinecraftTunnelMod"],
    "client": ["dev.terata.mctunnel.fabric.MinecraftTunnelClientMod"]
  },
  "mixins": ["minecraft_websocket_tunnel.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=21"
  }
}
